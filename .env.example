# Copy to `.env` (git-ignored). Loaded by `just` recipes (`just dev`, `just run`).
# Plain `cargo run` does not read it: export the variables yourself.

# Sentry DSN for opt-in error reports. Unset = reports off.
# Reports also need {"enabled": true} in diagnostics.json in the data folder.
GYMDIFF_SENTRY_DSN=

# Optional: fire a test event at start to check the reports end to end
# (error, scrubbed-error, panic, stack-overflow; see docs/Workflow/Releasing.md).
# GYMDIFF_TEST_CRASH=panic

# Optional: update from a local release list instead of GymDiff's releases; any build then
# replaces its own executable, so run a copy (see docs/Workflow/Releasing.md).
# GYMDIFF_UPDATE_URL=http://127.0.0.1:8765/releases.json

# Optional: use a throwaway data folder (welcome screen, consent) instead of the real one.
# GYMDIFF_DATA_DIR=/tmp/gymdiff-test
