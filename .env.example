# Copy to `.env` (git-ignored). Loaded by `just` recipes (`just dev`, `just run`).
# Plain `cargo run` does not read it: export the variables yourself.

# Sentry DSN for opt-in error reports. Unset = reports off.
# Reports also need {"enabled": true} in diagnostics.json in the data folder.
GYMDIFF_SENTRY_DSN=

# Optional: use a throwaway data folder (welcome screen, consent) instead of the real one.
# GYMDIFF_DATA_DIR=/tmp/gymdiff-test
