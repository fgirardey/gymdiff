// A session: one rounded panel with a summary header and the session's cards below it.
// This header is the neutral one (`text-secondary`) of a session of games from before GymDiff:
// label and subtitle only, no ring and no totals.
//
// Component `Session / Before GymDiff` in design/gymdiff.pen.

import { Theme } from "../theme.slint";

export component SessionPanel inherits Rectangle {
    /// "TODAY · #1".
    in property <string> label;
    /// "5 games · before GymDiff".
    in property <string> subtitle;

    background: Theme.background;
    border-radius: Theme.radius-panel;
    clip: true;
    height: panel.preferred-height;

    panel := VerticalLayout {
        // Summary header, with its line underneath.
        Rectangle {
            background: Theme.text-secondary.with-alpha(Theme.tint-header);
            // The header's own padding is in its preferred height; the line is 1 px more.
            height: header.preferred-height + 1px;

            header := VerticalLayout {
                padding: 10px;
                spacing: Theme.space-xs;
                alignment: start;

                Text {
                    text: root.label;
                    color: Theme.text-primary;
                    font-size: Theme.font-size-title;
                    font-weight: 800;
                    font-italic: true;
                }

                Text {
                    text: root.subtitle;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-body;
                    font-weight: 600;
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.text-secondary.with-alpha(Theme.tint-line);
            }
        }

        // The cards.
        Rectangle {
            background: Theme.text-secondary.with-alpha(Theme.tint-games);
            height: games.preferred-height;

            games := VerticalLayout {
                padding: 8px;
                spacing: 6px;
                alignment: start;

                @children
            }
        }
    }
}
