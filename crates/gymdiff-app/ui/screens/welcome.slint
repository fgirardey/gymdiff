// Welcome screen, shown on first launch.
//
// Frame in design/gymdiff.pen: `First launch / Welcome / Default`.

import { Theme } from "../theme.slint";
import { Crest } from "../components/crest.slint";
import { Icon } from "../components/icon.slint";
import { PrimaryButton } from "../components/primary-button.slint";
import { WelcomeRule } from "welcome-rule.slint";

export component WelcomeScreen inherits VerticalLayout {
    callback lets-go;

    padding: Theme.space-xl;
    spacing: Theme.space-l;

    HorizontalLayout {
        alignment: start;
        Crest { }
    }

    VerticalLayout {
        spacing: Theme.space-s;
        Text {
            text: "THE DIFF YOU GAVE AWAY, YOU PAY IN REPS.";
            color: Theme.text-primary;
            font-size: Theme.font-size-headline;
            font-weight: 800;
            font-italic: true;
            wrap: word-wrap;
        }
        Text {
            text: "After each Summoner's Rift game, GymDiff turns what you missed into a short workout.";
            color: Theme.text-secondary;
            font-size: Theme.font-size-body;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        spacing: Theme.space-m;
        WelcomeRule {
            icon: @image-url("../images/icons/burpee.svg");
            exercise: "Burpees";
            source: "your role's main stat under target";
        }
        WelcomeRule {
            icon: @image-url("../images/icons/squat.svg");
            exercise: "Squats";
            source: "your role's secondary stat under target";
        }
        WelcomeRule {
            icon: @image-url("../images/icons/plank.svg");
            exercise: "Plank";
            source: "10 seconds per death";
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }

    Text {
        text: "Listen to your body. Skip anything that hurts. GymDiff isn't a health app. Not endorsed by Riot Games.";
        color: Theme.text-secondary;
        font-size: Theme.font-size-body;
        wrap: word-wrap;
    }

    PrimaryButton {
        text: "Let's go";
        clicked => { root.lets-go(); }
    }
}
