// Edit the knobs in the live preview's Data tab; clicks show as the last action.
export component SettingsScreenPlayground inherits Window {
    in-out property <bool> crash-reports;
    in-out property <bool> all-logs;
    in-out property <bool> debug-tools: true;
    in-out property <bool> update-visible: true;
    in-out property <string> update-status: Fixtures.update-up-to-date;
    in-out property <bool> update-busy;

    background: Theme.background;
    preferred-width: 400px;
    preferred-height: 640px;

    playground := PreviewPlayground {
        padding: 0;
        alignment: stretch;

        SettingsScreen {
            vertical-stretch: 1;
            crash-reports: root.crash-reports;
            all-logs: root.all-logs;
            debug-tools: root.debug-tools;
            update-visible: root.update-visible;
            update-status: root.update-status;
            update-busy: root.update-busy;
            check-updates => { playground.log("check-updates"); }
            open-debug => { playground.log("open-debug"); }
            back => { playground.log("back"); }
            crash-reports-toggled => {
                root.crash-reports = !root.crash-reports;
                playground.log("crash-reports-toggled");
            }
            all-logs-toggled => {
                root.all-logs = !root.all-logs;
                playground.log("all-logs-toggled");
            }
        }
    }
}

// Gallery of every state (default component of the file).
export component Preview inherits Window {
    title: "SettingsScreen";
    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "App shell / Settings / Default";
            AppShellSettingsDefault { }
        }
        PreviewCase {
            label: "App shell / Settings / Crash reports on";
            AppShellSettingsCrashReportsOn { }
        }
        PreviewCase {
            label: "App shell / Settings / Updates checking";
            AppShellSettingsUpdatesChecking { }
        }
        PreviewCase {
            label: "App shell / Settings / Updates ready";
            AppShellSettingsUpdatesReady { }
        }
        PreviewCase {
            label: "App shell / Settings / Updates failed";
            AppShellSettingsUpdatesFailed { }
        }
        PreviewCase {
            label: "Without updates (not an alpha build)";
            AppShell {
                width: 400px;
                height: 640px;
                connected: true;
                status-label: Fixtures.status-lobby;
                settings-active: true;

                SettingsScreen { vertical-stretch: 1; }
            }
        }
        PreviewCase {
            label: "With the debug link (debug builds)";
            AppShell {
                width: 400px;
                height: 640px;
                connected: true;
                status-label: Fixtures.status-lobby;
                settings-active: true;

                SettingsScreen { vertical-stretch: 1; debug-tools: true; }
            }
        }
    }
}
