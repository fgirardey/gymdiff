// History screen with games: the sessions, newest first, each a panel of workout cards.
//
// Frames in design/gymdiff.pen: `History / Main / Before GymDiff`.

import { Theme } from "../theme.slint";
import { SessionData } from "../models.slint";
import { SessionPanel } from "../components/session-panel.slint";
import { WorkoutCard } from "../components/workout-card.slint";
import { NoWorkoutCard } from "../components/no-workout-card.slint";

export component HistorySessions inherits Flickable {
    in property <[SessionData]> sessions;

    content-width: self.width;
    content-height: content.preferred-height;

    content := VerticalLayout {
        width: parent.width;
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        Text {
            text: "HISTORY";
            color: Theme.text-primary;
            font-size: Theme.font-size-title;
            font-weight: 800;
            font-italic: true;
            letter-spacing: 1px;
        }

        for session in root.sessions: SessionPanel {
            label: session.label;
            subtitle: session.subtitle;

            for game in session.games: VerticalLayout {
                if game.has-workout: WorkoutCard {
                    game: game;
                    // Games from before GymDiff were never offered a workout: skipped.
                    status: "SKIPPED";
                    status-icon: @image-url("../images/icons/circle-x.svg");
                }

                if !game.has-workout: NoWorkoutCard {
                    game: game;
                }
            }
        }
    }
}
