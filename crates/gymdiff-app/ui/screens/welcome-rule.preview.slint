// Previews of WelcomeRule: `just preview screens/welcome-rule`.

import { Theme } from "../theme.slint";
import { WelcomeRule } from "welcome-rule.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";
import { PreviewPlayground } from "../preview-kit/preview-playground.slint";

// Edit the knobs in the live preview's Data tab.
export component WelcomeRulePlayground inherits Window {
    in-out property <string> exercise: "Burpees";
    in-out property <string> source: "your role's main stat under target";

    background: Theme.background;
    preferred-width: 360px;

    PreviewPlayground {
        WelcomeRule {
            icon: @image-url("../images/icons/burpee.svg");
            exercise: root.exercise;
            source: root.source;
        }
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "WelcomeRule";
    background: Theme.background;
    preferred-width: 360px;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Default";
            WelcomeRule {
                icon: @image-url("../images/icons/burpee.svg");
                exercise: "Burpees";
                source: "your role's main stat under target";
            }
        }
        PreviewCase {
            label: "Short source";
            WelcomeRule {
                icon: @image-url("../images/icons/plank.svg");
                exercise: "Plank";
                source: "10 seconds per death";
            }
        }
        PreviewCase {
            label: "Long source (wraps)";
            WelcomeRule {
                icon: @image-url("../images/icons/squat.svg");
                exercise: "Squats";
                source: "your role's secondary stat under target, measured over the whole game and every objective";
            }
        }
    }
}
