// Previews of the History screen: `just preview screens/history`.

import { Theme } from "../theme.slint";
import { AppShell } from "../shell/app-shell.slint";
import { HistoryEmpty } from "history.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// Pencil frame `History / Main / Empty` (400 × 640).
export component HistoryMainEmpty inherits Rectangle {
    width: 400px;
    height: 640px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;

        HistoryEmpty {
            vertical-stretch: 1;
        }
    }
}

// Gallery of every state (default component of the file).
export component Preview inherits Window {
    title: "History";
    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "History / Main / Empty";
            HistoryMainEmpty { }
        }
    }
}
