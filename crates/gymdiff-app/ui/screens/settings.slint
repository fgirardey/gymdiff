// Settings screen: opt-in error reports, updates (alpha builds) and shortcuts (installed
// builds). Scrolls when it is taller than the window.
//
// Frames in design/gymdiff.pen: `App shell / Settings / Default`,
// `App shell / Settings / Crash reports on`, `App shell / Settings / Updates checking`,
// `App shell / Settings / Updates ready`, `App shell / Settings / Updates failed`,
// `App shell / Settings / Scrolled to the bottom`.

import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { SettingRow } from "../components/setting-row.slint";
import { SecondaryButton } from "../components/secondary-button.slint";

export component SettingsScreen inherits Rectangle {
    in property <bool> crash-reports;
    in property <bool> all-logs;
    /// Shows the link to the throwaway debug screen (debug builds only).
    in property <bool> debug-tools;
    /// Shows the Updates section (builds that update themselves).
    in property <bool> update-visible;
    /// Status line under "Alpha channel", written by Rust.
    in property <string> update-status;
    /// A check or a download runs: "Check now" is disabled.
    in property <bool> update-busy;
    /// Shows the Shortcuts section (builds installed by the installer).
    in property <bool> shortcuts-visible;
    /// Whether each shortcut exists, written by Rust.
    in property <bool> shortcut-start-menu;
    in property <bool> shortcut-desktop;
    /// Scroll position (negative when scrolled down), and the content's height.
    in-out property <length> scroll-y <=> flick.viewport-y;
    out property <length> content-height: content.preferred-height;
    callback back;
    callback open-debug;
    /// The player clicked a switch; the parent decides whether the value changes.
    callback crash-reports-toggled;
    callback all-logs-toggled;
    callback check-updates;
    callback shortcut-start-menu-toggled;
    callback shortcut-desktop-toggled;

    flick := Flickable {
        viewport-width: self.width;
        viewport-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            width: parent.width;
            padding: Theme.space-l;
            spacing: Theme.space-m;
            alignment: start;

            HorizontalLayout {
                alignment: start;
                BackLink {
                    text: "History";
                    clicked => { root.back(); }
                }
            }

            Text {
                text: "SETTINGS";
                color: Theme.text-primary;
                font-size: Theme.font-size-title;
                font-weight: 800;
                font-italic: true;
                letter-spacing: 1px;
            }

            VerticalLayout {
                Text {
                    text: "ERROR REPORTS";
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                SettingRow {
                    label: "Send crash reports";
                    detail: "When GymDiff crashes or hits an error, send the scrubbed error, where it happened in the code, the app version and OS. A hard crash also sends a memory snapshot of GymDiff, used only to find the cause.";
                    checked: root.crash-reports;
                    toggled => { root.crash-reports-toggled(); }
                }

                SettingRow {
                    label: "Send all logs";
                    detail: "Also send everyday logs, scrubbed the same way. Helps fix bugs that don't crash.";
                    checked: root.all-logs;
                    toggled => { root.all-logs-toggled(); }
                }
            }

            Text {
                text: "Both are off by default. Reports are deleted after 30 days.";
                color: Theme.text-secondary;
                font-size: Theme.font-size-caption;
                wrap: word-wrap;
            }

            if root.update-visible: VerticalLayout {
                Text {
                    text: "UPDATES";
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                Rectangle {
                    HorizontalLayout {
                        padding-top: Theme.space-m;
                        padding-bottom: Theme.space-m;
                        spacing: Theme.space-m;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Theme.space-xs;

                            Text {
                                text: "Alpha channel";
                                color: Theme.text-primary;
                                font-size: Theme.font-size-body;
                                font-weight: 600;
                            }

                            Text {
                                text: root.update-status;
                                color: Theme.text-secondary;
                                font-size: Theme.font-size-body;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            SecondaryButton {
                                text: "Check now";
                                height: 36px;
                                enabled: !root.update-busy;
                                clicked => { root.check-updates(); }
                            }
                        }
                    }

                    // Bottom divider, like the setting rows above.
                    Rectangle {
                        y: parent.height - self.height;
                        height: 1px;
                        background: Theme.border;
                    }
                }
            }

            if root.shortcuts-visible: VerticalLayout {
                Text {
                    text: "SHORTCUTS";
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                    letter-spacing: 1px;
                }

                SettingRow {
                    label: "Start menu";
                    detail: "GymDiff in the Start menu and Windows Search.";
                    checked: root.shortcut-start-menu;
                    toggled => { root.shortcut-start-menu-toggled(); }
                }

                SettingRow {
                    label: "Desktop";
                    detail: "A GymDiff icon on your Desktop.";
                    checked: root.shortcut-desktop;
                    toggled => { root.shortcut-desktop-toggled(); }
                }
            }

            if root.debug-tools: HorizontalLayout {
                alignment: start;
                BackLink {
                    text: "Debug events";
                    clicked => { root.open-debug(); }
                }
            }
        }
    }
}
