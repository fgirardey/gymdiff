// Main window: Welcome (first launch), History, Settings and About.
//
// Screen map: docs/Product/Screens.md. Each screen lives in screens/, the
// app shell (top bar) in shell/, shared widgets in components/.

import { Theme } from "theme.slint";
import { Screen } from "screen.slint";
import { AppShell } from "shell/app-shell.slint";
import { WelcomeScreen } from "screens/welcome.slint";
import { HistoryEmpty } from "screens/history.slint";
import { AboutScreen } from "screens/about.slint";
import { SettingsScreen } from "screens/settings.slint";
import { DebugScreen } from "screens/debug.slint";

export { Screen }

export component AppWindow inherits Window {
    title: "GymDiff";
    preferred-width: 400px;
    preferred-height: 640px;
    background: Theme.background;

    /// The screen shown. Rust picks `welcome` at start when the welcome has not been seen.
    in-out property <Screen> screen: Screen.history;
    in property <bool> connected: false;
    in property <string> status-label: "Looking for the League client…";
    in property <string> version;
    /// Opt-in error reports (docs/Decisions/ADR-0006): set by Rust from the stored consent.
    in-out property <bool> crash-reports: false;
    in-out property <bool> all-logs: false;
    /// Throwaway debug screen, linked from Settings. Rust sets it in debug builds only.
    in property <bool> debug-tools: false;

    /// The player clicked "Let's go" on the welcome screen.
    callback welcome-done;
    /// The player flipped a switch in Settings; `enabled` is the new value.
    callback crash-reports-changed(enabled: bool);
    callback all-logs-changed(enabled: bool);
    /// Updates section in Settings (alpha builds), written by the updater.
    in property <bool> update-visible;
    in property <string> update-status;
    in property <bool> update-busy;
    /// "Check now" in Settings.
    callback check-updates;
    /// A button of the throwaway debug screen was pressed.
    callback debug-event(kind: string);

    if root.screen == Screen.welcome: WelcomeScreen {
        lets-go => {
            root.screen = Screen.history;
            root.welcome-done();
        }
    }

    if root.screen != Screen.welcome: AppShell {
        connected: root.connected;
        status-label: root.status-label;
        settings-active: root.screen == Screen.settings;
        about-active: root.screen == Screen.about;
        settings-clicked => { root.screen = Screen.settings; }
        about-clicked => { root.screen = Screen.about; }

        if root.screen == Screen.history: HistoryEmpty {
            vertical-stretch: 1;
        }

        if root.screen == Screen.about: AboutScreen {
            vertical-stretch: 1;
            version: root.version;
            back => { root.screen = Screen.history; }
        }

        if root.screen == Screen.settings: SettingsScreen {
            vertical-stretch: 1;
            crash-reports: root.crash-reports;
            all-logs: root.all-logs;
            update-visible: root.update-visible;
            update-status: root.update-status;
            update-busy: root.update-busy;
            check-updates => { root.check-updates(); }
            debug-tools: root.debug-tools;
            open-debug => { root.screen = Screen.debug; }
            back => { root.screen = Screen.history; }
            crash-reports-toggled => {
                root.crash-reports = !root.crash-reports;
                root.crash-reports-changed(root.crash-reports);
            }
            all-logs-toggled => {
                root.all-logs = !root.all-logs;
                root.all-logs-changed(root.all-logs);
            }
        }

        if root.screen == Screen.debug: DebugScreen {
            vertical-stretch: 1;
            fire(kind) => { root.debug-event(kind); }
            back => { root.screen = Screen.settings; }
        }
    }
}
