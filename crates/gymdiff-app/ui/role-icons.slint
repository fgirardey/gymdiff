// League position symbols, bundled with the app.
//
// Source: the League client's position icons (via CommunityDragon), used under
// Riot's "Legal Jibber Jabber" policy. See docs/Decisions/ADR-0005.

export global RoleIcons {
    out property <image> top: @image-url("images/roles/top.png");
    out property <image> jungle: @image-url("images/roles/jungle.png");
    out property <image> middle: @image-url("images/roles/middle.png");
    out property <image> bottom: @image-url("images/roles/bottom.png");
    out property <image> utility: @image-url("images/roles/utility.png");
}
