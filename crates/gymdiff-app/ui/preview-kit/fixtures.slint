// Fixed data shared by the previews, so every story uses the same realistic values.
//
// Mirror what Rust really sends: the status labels come from `status_label` in
// `src/watcher.rs` and `GamePhase::label` in gymdiff-core. When a screen takes a
// struct from `ui/models.slint`, its sample values go here too.

export global Fixtures {
    out property <string> version: "0.1.0 (build 57 · a1b2c3d)";

    out property <string> status-lobby: "Connected · Lobby";
    out property <string> status-champ-select: "Connected · Champion select";
    out property <string> status-searching: "Looking for the League client…";
    out property <string> status-error: "Error: connection refused (os error 61)";

    out property <string> setting-crash-label: "Send crash reports";
    out property <string> setting-crash-detail: "When GymDiff crashes or hits an error, send the scrubbed error, where it happened in the code, the app version and OS. A hard crash also sends a memory snapshot of GymDiff, used only to find the cause.";
    out property <string> setting-logs-label: "Send all logs";
    out property <string> update-up-to-date: "Up to date. Last checked at 14:05.";
    out property <string> update-checking: "Checking for updates…";
    out property <string> update-ready: "Build 58 is ready. It starts the next time you open GymDiff.";
    out property <string> update-failed: "Couldn't update: no connection. Next try in an hour.";
    out property <string> setting-logs-detail: "Also send everyday logs, scrubbed the same way. Helps fix bugs that don't crash.";
}
