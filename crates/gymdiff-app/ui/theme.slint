// Design tokens.
//
// SOURCE OF TRUTH: docs/Design/Tokens.md (mirrored from the Pencil design).
// Keep this file in sync with that note: same names, same values.

export global Theme {
    // Colors
    out property <color> background: #0d1117;
    out property <color> surface: #161b22;
    out property <color> border: #30363d;
    out property <color> text-primary: #e6edf3;
    out property <color> text-secondary: #8b949e;
    out property <color> accent: #3fb950;
    out property <color> success: #3fb950;
    out property <color> danger: #f85149;
    out property <color> warning: #d29922;

    // Spacing (logical pixels)
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 16px;
    out property <length> space-l: 24px;

    // Radius
    out property <length> radius-m: 8px;

    // Typography
    out property <length> font-size-body: 14px;
    out property <length> font-size-title: 20px;
    out property <length> font-size-display: 40px;
    out property <length> font-size-hero: 96px;
}
