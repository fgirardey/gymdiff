// The installer window (gymdiff-installer, ADR-0012): routes the player's choices to Rust.
// Content and frames: installer/installer-screen.slint.

import { Theme } from "theme.slint";
import { InstallerScreen } from "installer/installer-screen.slint";
import { InstallerStep } from "installer-step.slint";

export { InstallerStep }

export component InstallerWindow inherits Window {
    title: "GymDiff Setup";
    icon: @image-url("images/app-icon.png");
    width: 420px;
    height: 500px;
    background: Theme.background;

    in-out property <InstallerStep> step: InstallerStep.options;
    in property <string> version;
    in property <string> failure-reason;
    in-out property <bool> start-menu: true;
    in-out property <bool> desktop: false;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> launch: true;
    /// Install with the current choices; Rust moves through the steps.
    callback install;
    /// Close without installing (Cancel), or after a failure (Close).
    callback quit;
    /// Done: launch GymDiff if `launch`, then close.
    callback finish;

    InstallerScreen {
        step: root.step;
        version: root.version;
        failure-reason: root.failure-reason;
        start-menu: root.start-menu;
        desktop: root.desktop;
        start-with-windows: root.start-with-windows;
        launch: root.launch;
        start-menu-toggled => { root.start-menu = !root.start-menu; }
        desktop-toggled => { root.desktop = !root.desktop; }
        start-with-windows-toggled => { root.start-with-windows = !root.start-with-windows; }
        launch-toggled => { root.launch = !root.launch; }
        install => { root.install(); }
        cancel => { root.quit(); }
        close => { root.quit(); }
        finish => { root.finish(); }
    }
}
