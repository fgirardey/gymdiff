// Square icon button of the top bar (Settings, About). Marked while its screen is shown,
// tinted on hover and pressed.
//
// Frames in design/cooldown.pen: `Nav / Settings` and `Nav / About` in `App shell / Top bar / Default`.

import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { StateLayer } from "state-layer.slint";

export component NavButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: Theme.radius-m;
    background: root.active ? Theme.border : transparent;

    StateLayer {
        border-radius: root.border-radius;
        tint: Theme.text-primary;
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }

    Icon {
        source: root.icon;
        width: 22px;
        height: 22px;
        colorize: root.active || touch.has-hover ? Theme.text-primary : Theme.text-secondary;
        animate colorize {
            duration: Theme.motion-fast;
            easing: ease-out;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
