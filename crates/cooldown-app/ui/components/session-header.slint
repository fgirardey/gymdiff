// The header of a session in History: its label, then chips with its summary and its wins and
// losses.
//
// Component `Session header / Games` in design/cooldown.pen; the workout progress of the
// other headers needs workouts done in cooldown.lol, not wired yet.

import { Theme } from "../theme.slint";

export component SessionHeader inherits HorizontalLayout {
    /// "TODAY · #1".
    in property <string> label;
    /// "3 games · before cooldown.lol".
    in property <string> subtitle;
    in property <int> wins;
    in property <int> losses;

    height: 40px;
    padding-top: Theme.space-s;
    padding-left: Theme.space-xs;
    padding-right: Theme.space-xs;
    spacing: Theme.space-s;

    Text {
        font-family: Theme.font-display;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.font-size-wordmark;
        font-weight: 800;
        font-italic: true;
        vertical-alignment: center;
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    VerticalLayout {
        alignment: center;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-chip;
            HorizontalLayout {
                padding-top: 3px;
                padding-bottom: 3px;
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                Text {
                    font-family: Theme.font-body;
                    text: root.subtitle;
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                }
            }
        }
    }

    VerticalLayout {
        alignment: center;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-chip;
            HorizontalLayout {
                padding-top: 3px;
                padding-bottom: 3px;
                padding-left: Theme.space-s;
                padding-right: Theme.space-s;
                spacing: 6px;
                Text {
                    font-family: Theme.font-body;
                    text: root.wins + " W";
                    color: Theme.info;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                }
                Text {
                    font-family: Theme.font-body;
                    text: root.losses + " L";
                    color: Theme.danger;
                    font-size: Theme.font-size-caption;
                    font-weight: 600;
                }
            }
        }
    }
}
