// Outlined button for secondary actions (`Secondary button / *` in the
// `Interaction states` section of the `Foundations` page; compact 36px variant
// in `App shell / Settings / Default`; destructive variant, in `$danger`, for
// Uninstall in `App shell / Settings / Scrolled to the bottom`). Tinted on hover
// and pressed, shrinks a little while pressed; faded and inert when disabled.

import { Theme } from "../theme.slint";
import { StateLayer } from "state-layer.slint";

export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    /// An action that removes something: outline and label in `danger`.
    in property <bool> destructive;
    callback clicked;

    height: 44px;
    min-width: label.preferred-width + 2 * Theme.space-m;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: root.destructive ? Theme.danger : Theme.border;
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    transform-scale: touch.pressed ? Theme.press-scale : 1;
    animate transform-scale {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    StateLayer {
        border-radius: root.border-radius;
        tint: root.destructive ? Theme.danger : Theme.text-primary;
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }

    label := Text {
        text: root.text;
        color: root.destructive ? Theme.danger : Theme.text-primary;
        font-size: Theme.font-size-body;
        font-weight: 600;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}
