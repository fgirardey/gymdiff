// Previews of WorkoutCard: `just preview components/workout-card`.

import { Theme } from "../theme.slint";
import { WorkoutCard } from "workout-card.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// Pencil frame `Workout card / Skipped` (352 wide).
export component WorkoutCardSkipped inherits Rectangle {
    width: 352px;
    background: Theme.background;
    height: card.height;

    card := WorkoutCard {
        game: Fixtures.game-ashe;
        status: "SKIPPED";
        status-icon: @image-url("../images/icons/circle-x.svg");
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "WorkoutCard";
    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Workout card / Skipped";
            WorkoutCardSkipped { }
        }

        PreviewCase {
            label: "Portrait not downloaded: initials";
            WorkoutCard {
                width: 352px;
                game: Fixtures.game-ahri-no-image;
                status: "SKIPPED";
                status-icon: @image-url("../images/icons/circle-x.svg");
            }
        }
    }
}
