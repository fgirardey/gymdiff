// Previews of ExerciseColumn: `just preview components/exercise-column`.

import { Theme } from "../theme.slint";
import { ExerciseColumn } from "exercise-column.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// `Exercise B` of `Game row / Workouts / Skipped`: capped burpees.
export component ExerciseColumnBurpees inherits Rectangle {
    width: 240px;
    height: 64px;
    background: Theme.surface;

    ExerciseColumn {
        exercise: Fixtures.game-jinx.exercises[0];
        exercise-icon: @image-url("../images/icons/burpee.svg");
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "ExerciseColumn";
    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Exercise B (capped)";
            ExerciseColumnBurpees { }
        }

        PreviewCase {
            label: "Exercise S";
            Rectangle {
                width: 240px;
                height: 64px;
                background: Theme.surface;
                ExerciseColumn {
                    exercise: Fixtures.game-jinx.exercises[1];
                    exercise-icon: @image-url("../images/icons/squat.svg");
                }
            }
        }

        PreviewCase {
            label: "Exercise P";
            Rectangle {
                width: 240px;
                height: 64px;
                background: Theme.surface;
                ExerciseColumn {
                    exercise: Fixtures.game-jinx.exercises[2];
                    exercise-icon: @image-url("../images/icons/plank.svg");
                }
            }
        }

        PreviewCase {
            label: "On target: nothing due";
            Rectangle {
                width: 240px;
                height: 64px;
                background: Theme.surface;
                ExerciseColumn {
                    exercise: Fixtures.game-kaisa.exercises[0];
                    exercise-icon: @image-url("../images/icons/burpee.svg");
                }
            }
        }
    }
}
