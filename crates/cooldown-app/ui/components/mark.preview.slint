// Previews of Mark: `just preview components/mark`.

import { Theme } from "../theme.slint";
import { Mark } from "mark.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// Pencil frame `Logo / Mark`: the master drawing, at its 128 × 128 size.
export component LogoMark inherits Rectangle {
    width: 128px;
    height: 128px;
    background: Theme.background;

    Mark {
        width: parent.width;
        height: parent.height;
    }
}

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "Mark";
    background: Theme.background;
    preferred-width: 200px;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Logo / Mark";
            HorizontalLayout {
                alignment: start;
                LogoMark { }
            }
        }
        PreviewCase {
            label: "Standard size (28 × 28)";
            HorizontalLayout {
                alignment: start;
                Mark { }
            }
        }
        PreviewCase {
            label: "On surface";
            Rectangle {
                background: Theme.surface;
                height: 60px;
                HorizontalLayout {
                    padding: Theme.space-s;
                    alignment: start;
                    Mark { }
                }
            }
        }
    }
}
