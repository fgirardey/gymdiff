// Full-width call-to-action button (accent background; `danger` for a destructive
// action, like Uninstall in `App shell / Settings / Uninstall confirm`).
// Tinted on hover and pressed, and shrinks a little while pressed.

import { Theme } from "../theme.slint";
import { StateLayer } from "state-layer.slint";

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    /// An action that removes something: `danger` background.
    in property <bool> destructive;
    callback clicked;

    height: 44px;
    border-radius: Theme.radius-m;
    background: root.destructive ? Theme.danger : Theme.accent;
    transform-scale: touch.pressed ? Theme.press-scale : 1;
    animate transform-scale {
        duration: Theme.motion-fast;
        easing: ease-out;
    }

    StateLayer {
        border-radius: root.border-radius;
        tint: Theme.background;
        hovered: touch.has-hover;
        pressed: touch.pressed;
    }

    Text {
        font-family: Theme.font-body;
        text: root.text;
        color: Theme.background;
        font-size: Theme.font-size-body;
        font-weight: 700;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
