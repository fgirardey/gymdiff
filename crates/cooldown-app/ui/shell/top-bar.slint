// Top bar: mark, wordmark, client status and the Settings and About buttons.
//
// Frame in design/cooldown.pen: `App shell / Top bar / Default`.

import { Theme } from "../theme.slint";
import { Mark } from "../components/mark.slint";
import { NavButton } from "../components/nav-button.slint";
import { ConnectionStatus } from "connection-status.slint";

export component TopBar inherits Rectangle {
    in property <bool> connected;
    in property <string> status-label;
    in property <bool> settings-active;
    in property <bool> about-active;
    callback settings-clicked;
    callback about-clicked;

    height: 52px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;

        VerticalLayout {
            alignment: center;
            Mark { }
        }

        // `COOLDOWN` and its `.LOL` in the accent colour.
        HorizontalLayout {
            padding-left: Theme.space-xs;
            Text {
                font-family: Theme.font-display;
                text: "COOLDOWN";
                color: Theme.text-primary;
                font-size: Theme.font-size-wordmark;
                font-weight: 800;
                font-italic: true;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
            Text {
                font-family: Theme.font-display;
                text: ".LOL";
                color: Theme.accent;
                font-size: Theme.font-size-wordmark;
                font-weight: 800;
                font-italic: true;
                letter-spacing: 1px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        ConnectionStatus {
            connected: root.connected;
            label: root.status-label;
        }

        VerticalLayout {
            alignment: center;
            NavButton {
                icon: @image-url("../images/icons/settings.svg");
                active: root.settings-active;
                clicked => { root.settings-clicked(); }
            }
        }

        VerticalLayout {
            alignment: center;
            NavButton {
                icon: @image-url("../images/icons/info.svg");
                active: root.about-active;
                clicked => { root.about-clicked(); }
            }
        }
    }

    // Bottom border
    Rectangle {
        y: parent.height - self.height;
        height: 1px;
        background: Theme.border;
    }
}
