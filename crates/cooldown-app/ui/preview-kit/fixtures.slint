        champion-image: @image-url("../../../../design/assets/champions/Kaisa.png"),
        has-champion-image: true,
        champion-initials: "KA",
        role-icon: RoleIcons.bottom,
        has-role: true,
        result-label: "WIN",
        win: true,
        kda: "11/4/6",
