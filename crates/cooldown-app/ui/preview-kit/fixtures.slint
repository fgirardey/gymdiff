    out property <GameCardData> game-ahri-no-image: {
        champion-image: @image-url("../../../../design/assets/champions/Ahri.png"),
        has-champion-image: false,
        champion-initials: "AH",
        role-icon: RoleIcons.middle,
        has-role: true,
        result-label: "WIN",
        win: true,
