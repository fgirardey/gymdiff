// Fixed data shared by the previews, so every story uses the same realistic values.
//
// Mirror what Rust really sends: the status labels come from `status_label` in
// `src/watcher.rs` and `GamePhase::label` in cooldown-core. When a screen takes a
// struct from `ui/models.slint`, its sample values go here too.

import { GameCardData, SessionData } from "../models.slint";
import { RoleIcons } from "../role-icons.slint";

export global Fixtures {
    out property <string> version: "0.1.0 (build 57 · a1b2c3d)";

    out property <string> status-lobby: "Connected · Lobby";
    out property <string> status-champ-select: "Connected · Champion select";
    out property <string> status-searching: "Looking for the League client…";
    out property <string> status-error: "Error: connection refused (os error 61)";

    out property <string> setting-crash-label: "Send crash reports";
    out property <string> setting-crash-detail: "When cooldown.lol crashes or hits an error, send the scrubbed error, where it happened in the code, the app version and OS. A hard crash also sends a memory snapshot of cooldown.lol, used only to find the cause.";
    out property <string> setting-logs-label: "Send all logs";
    out property <string> update-up-to-date: "Up to date. Last checked at 14:05.";
    out property <string> update-checking: "Checking for updates…";
    out property <string> update-ready: "Build 58 is ready. It starts the next time you open cooldown.lol.";
    out property <string> update-failed: "Couldn't update: no connection. Next try in an hour.";
    out property <string> installer-version: "0.1.0 (build 62)";
    out property <string> installer-failure: "the installation was interrupted";
    out property <string> uninstall-delete-detail: "Preferences, error-report choice and install id. Keep them to pick up where you left off if you reinstall.";
    out property <string> setting-logs-detail: "Also send everyday logs, scrubbed the same way. Helps fix bugs that don't crash.";

    // Games, as Rust sends them (src/history_view.rs). Portraits use the Data Dragon squares
    // kept in design/assets (the app downloads them, ADR-0004).
    out property <GameCardData> game-jinx: {
        champion-image: @image-url("../../../../design/assets/champions/Jinx.png"),
        has-champion-image: true,
        champion-initials: "JI",
        role-icon: RoleIcons.bottom,
        has-role: true,
        result-label: "WIN",
        win: true,
        kda: "9/3/7",
        has-workout: true,
