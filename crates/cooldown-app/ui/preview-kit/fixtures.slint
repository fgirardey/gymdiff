    // Sessions of games from before cooldown.lol, like frame `History / Main / Before cooldown.lol`.
    out property <[SessionData]> sessions-before-cooldown: [
        {
            label: "TODAY · #1",
            subtitle: "3 games · before cooldown.lol",
            neutral: true,
            games: [self.game-jinx, self.game-ashe, self.game-kaisa],
