// Welcome screen, shown on first launch.
//
// Frame in design/cooldown.pen: `First launch / Welcome / Default`.

import { Theme } from "../theme.slint";
import { Mark } from "../components/mark.slint";
import { Icon } from "../components/icon.slint";
import { PrimaryButton } from "../components/primary-button.slint";
import { WelcomeRule } from "welcome-rule.slint";

export component WelcomeScreen inherits VerticalLayout {
    callback lets-go;

    // A 560 px column, centred in the window.
    padding-top: Theme.space-xl;
    padding-bottom: Theme.space-xl;
    padding-left: max(Theme.space-xl, (self.width - 560px) / 2);
    padding-right: max(Theme.space-xl, (self.width - 560px) / 2);
    spacing: Theme.space-l;
    alignment: center;

    HorizontalLayout {
        alignment: start;
        Mark { }
    }

    VerticalLayout {
        spacing: Theme.space-s;
        Text {
            font-family: Theme.font-display;
            text: "THE DIFF YOU GAVE AWAY, YOU PAY IN REPS.";
            color: Theme.text-primary;
            font-size: Theme.font-size-headline;
            font-weight: 800;
            font-italic: true;
            wrap: word-wrap;
        }
        Text {
            font-family: Theme.font-body;
            text: "After each Summoner's Rift game, cooldown.lol turns what you missed into a short workout.";
            color: Theme.text-secondary;
            font-size: Theme.font-size-body;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        spacing: Theme.space-m;
        WelcomeRule {
            icon: @image-url("../images/icons/burpee.svg");
            exercise: "Burpees";
            source: "your role's main stat under target";
        }
        WelcomeRule {
            icon: @image-url("../images/icons/squat.svg");
            exercise: "Squats";
            source: "your role's secondary stat under target";
        }
        WelcomeRule {
            icon: @image-url("../images/icons/plank.svg");
            exercise: "Plank";
            source: "10 seconds per death";
        }
    }

    Rectangle {
        height: Theme.space-m;
    }

    Text {
        font-family: Theme.font-body;
        text: "Listen to your body. Skip anything that hurts. cooldown.lol isn't a health app. Not endorsed by Riot Games.";
        color: Theme.text-secondary;
        font-size: Theme.font-size-body;
        wrap: word-wrap;
    }

    PrimaryButton {
        text: "Let's go";
        clicked => { root.lets-go(); }
    }
}
