// Pencil frame `App shell / Settings / Scrolled to the bottom` (1280 × 800).
export component AppShellSettingsScrolledToTheBottom inherits Rectangle {
    width: 1280px;
    height: 800px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;
        settings-active: true;

        SettingsScreen {
            vertical-stretch: 1;
            update-visible: true;
            update-status: Fixtures.update-up-to-date;
            shortcuts-visible: true;
            shortcut-start-menu: true;
            startup-visible: true;
            uninstall-visible: true;
            scroll-y: min(0px, self.height - self.content-height);
        }
    }
}

// Edit the knobs in the live preview's Data tab; clicks show as the last action.
export component SettingsScreenPlayground inherits Window {
    in-out property <bool> crash-reports;
    in-out property <bool> all-logs;
    in-out property <bool> debug-tools: true;
    in-out property <bool> update-visible: true;
    in-out property <string> update-status: Fixtures.update-up-to-date;
    in-out property <bool> update-busy;
    in-out property <bool> shortcuts-visible: true;
    in-out property <bool> shortcut-start-menu: true;
    in-out property <bool> shortcut-desktop;
    in-out property <bool> startup-visible: true;
    in-out property <bool> start-with-windows;
    in-out property <bool> uninstall-visible: true;

    background: Theme.background;
    preferred-width: 1280px;
    preferred-height: 800px;

    playground := PreviewPlayground {
        padding: 0;
        alignment: stretch;

        SettingsScreen {
            vertical-stretch: 1;
            crash-reports: root.crash-reports;
            all-logs: root.all-logs;
            debug-tools: root.debug-tools;
            update-visible: root.update-visible;
            update-status: root.update-status;
            update-busy: root.update-busy;
            check-updates => { playground.log("check-updates"); }
            shortcuts-visible: root.shortcuts-visible;
            shortcut-start-menu: root.shortcut-start-menu;
            shortcut-desktop: root.shortcut-desktop;
            shortcut-start-menu-toggled => {
                root.shortcut-start-menu = !root.shortcut-start-menu;
                playground.log("shortcut-start-menu-toggled");
            }
            shortcut-desktop-toggled => {
                root.shortcut-desktop = !root.shortcut-desktop;
                playground.log("shortcut-desktop-toggled");
            }
            startup-visible: root.startup-visible;
            start-with-windows: root.start-with-windows;
            start-with-windows-toggled => {
                root.start-with-windows = !root.start-with-windows;
                playground.log("start-with-windows-toggled");
            }
            uninstall-visible: root.uninstall-visible;
            uninstall-clicked => { playground.log("uninstall-clicked"); }
            open-debug => { playground.log("open-debug"); }
            back => { playground.log("back"); }
            crash-reports-toggled => {
                root.crash-reports = !root.crash-reports;
                playground.log("crash-reports-toggled");
            }
            all-logs-toggled => {
                root.all-logs = !root.all-logs;
                playground.log("all-logs-toggled");
            }
        }
    }
}

// Gallery of every state (default component of the file).
export component Preview inherits Window {
    title: "SettingsScreen";
    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "App shell / Settings / Default";
            AppShellSettingsDefault { }
        }
        PreviewCase {
            label: "App shell / Settings / Crash reports on";
            AppShellSettingsCrashReportsOn { }
        }
        PreviewCase {
            label: "App shell / Settings / Updates checking";
            AppShellSettingsUpdatesChecking { }
        }
        PreviewCase {
            label: "App shell / Settings / Updates ready";
            AppShellSettingsUpdatesReady { }
        }
        PreviewCase {
            label: "App shell / Settings / Updates failed";
            AppShellSettingsUpdatesFailed { }
        }
        PreviewCase {
            label: "App shell / Settings / Scrolled to the bottom";
            AppShellSettingsScrolledToTheBottom { }
        }
        PreviewCase {
            label: "Not installed: no updates, shortcuts, startup or uninstall";
            AppShell {
                width: 1280px;
                height: 800px;
                connected: true;
                status-label: Fixtures.status-lobby;
                settings-active: true;

                SettingsScreen { vertical-stretch: 1; }
            }
        }
        PreviewCase {
            label: "With the debug link (debug builds)";
            AppShell {
                width: 1280px;
                height: 800px;
                connected: true;
                status-label: Fixtures.status-lobby;
                settings-active: true;

                SettingsScreen { vertical-stretch: 1; debug-tools: true; }
            }
        }
    }
}
