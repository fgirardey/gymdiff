// Previews of HistorySessions: `just preview screens/history-sessions`.
//
// The frame story `HistoryMainBeforeCooldown` lives in history.preview.slint, with the other
// states of the History screen.

import { Theme } from "../theme.slint";
import { HistorySessions } from "history-sessions.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// Gallery of every variant (default component of the file).
export component Preview inherits Window {
    title: "HistorySessions";
    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "Sessions of games from before cooldown.lol";
            HistorySessions {
                width: 400px;
                height: 560px;
                sessions: Fixtures.sessions-before-cooldown;
            }
        }

        PreviewCase {
            label: "No session";
            HistorySessions {
                width: 400px;
                height: 560px;
            }
        }
    }
}
