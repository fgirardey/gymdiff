// Previews of the History screen: `just preview screens/history`.

import { Theme } from "../theme.slint";
import { AppShell } from "../shell/app-shell.slint";
import { HistoryEmpty } from "history.slint";
import { HistorySessions } from "history-sessions.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";

// Pencil frame `History / Main / Empty` (1280 × 800).
export component HistoryMainEmpty inherits Rectangle {
    width: 1280px;
    height: 800px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;

        HistoryEmpty {
            vertical-stretch: 1;
        }
    }
}

// Pencil frame `History / Main / Before cooldown.lol` (1280 × 800).
export component HistoryMainBeforeCooldown inherits Rectangle {
    width: 1280px;
    height: 800px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;

        HistorySessions {
            vertical-stretch: 1;
            updated: "Updated 2 min ago";
            sessions: Fixtures.sessions-before-cooldown;
        }
    }
}

// Pencil frame `History / Main / Workouts view (desktop)` (1280 × 800), games of Before cooldown.lol.
export component HistoryMainWorkoutsView inherits Rectangle {
    width: 1280px;
    height: 800px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;

        HistorySessions {
            vertical-stretch: 1;
            updated: "Updated 2 min ago";
            sessions: Fixtures.sessions-before-cooldown;
            workouts: true;
        }
    }
}

// Pencil frame `History / Main / No workout` (1280 × 800).
export component HistoryMainNoWorkout inherits Rectangle {
    width: 1280px;
    height: 800px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;

        HistorySessions {
            vertical-stretch: 1;
            updated: "Updated 2 min ago";
            sessions: Fixtures.sessions-no-workout;
        }
    }
}

// Gallery of every state (default component of the file).
export component Preview inherits Window {
    title: "History";
    background: Theme.background;

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "History / Main / Empty";
            HistoryMainEmpty { }
        }

        PreviewCase {
            label: "History / Main / Before cooldown.lol";
            HistoryMainBeforeCooldown { }
        }

        PreviewCase {
            label: "History / Main / Workouts view (desktop)";
            HistoryMainWorkoutsView { }
        }

        PreviewCase {
            label: "History / Main / No workout";
            HistoryMainNoWorkout { }
        }
    }
}
