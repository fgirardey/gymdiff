// About screen: version, Slint licensing notice and Riot legal text.
//
// Frame in design/cooldown.pen: `App shell / About / Default`.

import { AboutSlint } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";

export component AboutScreen inherits VerticalLayout {
    in property <string> version;
    callback back;

    // A 720 px column, centred in the window.
    padding-top: Theme.space-l;
    padding-bottom: Theme.space-l;
    padding-left: max(Theme.space-l, (self.width - 720px) / 2);
    padding-right: max(Theme.space-l, (self.width - 720px) / 2);
    spacing: Theme.space-m;
    alignment: start;

    HorizontalLayout {
        alignment: start;
        BackLink {
            text: "History";
            clicked => { root.back(); }
        }
    }

    Text {
        font-family: Theme.font-display;
        text: "ABOUT";
        color: Theme.text-primary;
        font-size: Theme.font-size-title;
        font-weight: 800;
        font-italic: true;
        letter-spacing: 1px;
    }

    Text {
        font-family: Theme.font-body;
        text: "cooldown.lol " + root.version;
        color: Theme.text-primary;
        font-size: Theme.font-size-body;
        font-weight: 600;
    }

    // Required by the Slint Royalty-free license: AboutSlint must be
    // reachable from the top level of the app. See docs/Decisions/ADR-0001.
    Rectangle {
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: Theme.space-m;
            AboutSlint { }
        }
    }

    Text {
        font-family: Theme.font-body;
        text: "cooldown.lol isn't endorsed by Riot Games and doesn't reflect the views or opinions of Riot Games or anyone officially involved in producing or managing Riot Games properties. Riot Games, and all associated properties are trademarks or registered trademarks of Riot Games, Inc.";
        color: Theme.text-secondary;
        font-size: Theme.font-size-body;
        wrap: word-wrap;
    }
}
