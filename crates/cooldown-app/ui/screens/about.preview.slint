// Previews of AboutScreen: `just preview screens/about`.

import { Theme } from "../theme.slint";
import { AppShell } from "../shell/app-shell.slint";
import { AboutScreen } from "about.slint";
import { Fixtures } from "../preview-kit/fixtures.slint";
import { PreviewCase } from "../preview-kit/preview-case.slint";
import { PreviewPlayground } from "../preview-kit/preview-playground.slint";

// Pencil frame `App shell / About / Default` (1280 × 800).
export component AppShellAboutDefault inherits Rectangle {
    width: 1280px;
    height: 800px;
    background: Theme.background;
    clip: true;

    AppShell {
        connected: true;
        status-label: Fixtures.status-lobby;
        about-active: true;

        AboutScreen {
            vertical-stretch: 1;
            version: Fixtures.version;
        }
    }
}

// Edit the knobs in the live preview's Data tab; "History" shows as the last action.
export component AboutScreenPlayground inherits Window {
    in-out property <string> version: Fixtures.version;

    background: Theme.background;
    preferred-width: 1280px;
    preferred-height: 800px;

    playground := PreviewPlayground {
        padding: 0;
        alignment: stretch;

        AboutScreen {
            vertical-stretch: 1;
            version: root.version;
            back => { playground.log("back"); }
        }
    }
}

// Gallery of every state (default component of the file).
export component Preview inherits Window {
    title: "AboutScreen";
    background: Theme.background;

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        alignment: start;

        PreviewCase {
            label: "App shell / About / Default";
            AppShellAboutDefault { }
        }
    }
}
