// History screen with games: the title row with the view switch and the refresh, then the
// sessions, newest first, each a header and one row per game.
//
// Frames in design/cooldown.pen: `History / Main / Before cooldown.lol`,
// `History / Main / Games view (desktop)`, `History / Main / Workouts view (desktop)`.

import { Theme } from "../theme.slint";
import { SessionData } from "../models.slint";
import { ViewSwitch } from "../components/view-switch.slint";
import { SessionHeader } from "../components/session-header.slint";
import { GameRow } from "../components/game-row.slint";
import { HistoryRefresh } from "history-refresh.slint";

export component HistorySessions inherits VerticalLayout {
    in property <[SessionData]> sessions;
    /// The Workouts view is shown; the Games view otherwise.
    in-out property <bool> workouts;
    /// The refresh at the end of the title row: "Updated 2 min ago", a read running, the client
    /// there to read from.
    in property <string> updated;
    in property <bool> refreshing;
    in property <bool> can-refresh: true;
    /// The player asked to read the client's match history again.
    callback refresh;

    padding-top: 20px;
    padding-left: Theme.space-xl;
    padding-right: Theme.space-xl;
    spacing: 6px;

    HorizontalLayout {
        spacing: Theme.space-m;
        padding-bottom: Theme.space-s;
        height: 40px;

        Text {
            font-family: Theme.font-display;
            text: "HISTORY";
            color: Theme.text-primary;
            font-size: Theme.font-size-title;
            font-weight: 800;
            font-italic: true;
            letter-spacing: 1px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            ViewSwitch {
                workouts: root.workouts;
                picked(workouts) => { root.workouts = workouts; }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            font-family: Theme.font-body;
            text: root.workouts
                ? "Each exercise pays for one stat under its target"
                : "Red = under your target · tick = target for the role";
            color: Theme.text-secondary;
            font-size: Theme.font-size-caption;
            vertical-alignment: center;
            // Against the refresh: the push takes the free space.
            horizontal-stretch: 0;
        }

        HistoryRefresh {
            horizontal-stretch: 0;
            updated: root.updated;
            refreshing: root.refreshing;
            enabled: root.can-refresh;
            clicked => { root.refresh(); }
        }
    }

    Flickable {
        vertical-stretch: 1;
        content-width: self.width;
        content-height: list.preferred-height;

        list := VerticalLayout {
            width: parent.width;
            padding-bottom: 20px;
            spacing: 6px;
            alignment: start;

            for session in root.sessions: VerticalLayout {
                spacing: 6px;

                SessionHeader {
                    label: session.label;
                    subtitle: session.subtitle;
                    wins: session.wins;
                    losses: session.losses;
                }

                for game in session.games: GameRow {
                    game: game;
                    workouts: root.workouts;
                }
            }
        }
    }
}
