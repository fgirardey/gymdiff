// History screen.
//
// Frame in design/cooldown.pen: `History / Main / Empty`.

import { Theme } from "../theme.slint";
import { Icon } from "../components/icon.slint";

// Empty state, until the first game is recorded.
export component HistoryEmpty inherits VerticalLayout {
    padding: Theme.space-l;
    spacing: Theme.space-m;
    alignment: center;

    HorizontalLayout {
        alignment: center;
        Icon {
            source: @image-url("../images/icons/history.svg");
            width: 34px;
            height: 34px;
            colorize: Theme.text-secondary;
        }
    }

    Text {
        text: "No game yet";
        color: Theme.text-primary;
        font-size: Theme.font-size-title;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        text: "Every Summoner's Rift game you finish while cooldown.lol is open is listed here, grouped by session.";
        color: Theme.text-secondary;
        font-size: Theme.font-size-body;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}
