// Main window: Welcome (first launch), History, Settings and About.
//
// Screen map: docs/Product/Screens.md. Each screen lives in screens/, the
// app shell (top bar) in shell/, shared widgets in components/.

import { Theme } from "theme.slint";
import { Screen } from "screen.slint";
import { AppShell } from "shell/app-shell.slint";
import { WelcomeScreen } from "screens/welcome.slint";
import { HistoryEmpty } from "screens/history.slint";
import { HistorySessions } from "screens/history-sessions.slint";
import { SessionData, GameRowData, StatData, ExerciseData, TermData, StatKind } from "models.slint";
import { RoleIcons } from "role-icons.slint";
import { AboutScreen } from "screens/about.slint";
import { SettingsScreen } from "screens/settings.slint";
import { SettingsUninstallDialog } from "screens/settings-uninstall-dialog.slint";
import { DebugScreen } from "screens/debug.slint";

export { Screen, SessionData, GameRowData, StatData, ExerciseData, TermData, StatKind, RoleIcons }

export component AppWindow inherits Window {
    title: "cooldown.lol";
    // Title bar and task bar: the mark (`docs/Design/Brand.md`, app icon).
    icon: @image-url("images/app-icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.background;
    default-font-family: Theme.font-body;

    /// The screen shown. Rust picks `welcome` at start when the welcome has not been seen.
    in-out property <Screen> screen: Screen.history;
    in property <bool> connected: false;
    in property <string> status-label: "Looking for the League client…";
    in property <string> version;
    /// The games of the History screen, newest session first (set by Rust from the history).
    in property <[SessionData]> sessions;
    /// History shows the Workouts view; the Games view otherwise.
    in-out property <bool> history-workouts: false;
    /// Opt-in error reports (docs/Decisions/ADR-0006): set by Rust from the stored consent.
    in-out property <bool> crash-reports: false;
    in-out property <bool> all-logs: false;
    /// Throwaway debug screen, linked from Settings. Rust sets it in debug builds only.
    in property <bool> debug-tools: false;

    /// The player clicked "Let's go" on the welcome screen.
    callback welcome-done;
    /// The player flipped a switch in Settings; `enabled` is the new value.
    callback crash-reports-changed(enabled: bool);
    callback all-logs-changed(enabled: bool);
    /// Updates section in Settings (alpha builds), written by the updater.
    in property <bool> update-visible;
    in property <string> update-status;
    in property <bool> update-busy;
    /// "Check now" in Settings.
    callback check-updates;
    /// Shortcuts section in Settings (installed builds); Rust sets whether each exists.
    in property <bool> shortcuts-visible;
    in-out property <bool> shortcut-start-menu;
    in-out property <bool> shortcut-desktop;
    /// The player flipped a shortcut switch; `wanted` is the new value.
    callback shortcut-start-menu-changed(wanted: bool);
    callback shortcut-desktop-changed(wanted: bool);
    /// Startup section in Settings (installed builds); Rust sets whether Windows starts cooldown.lol.
    in property <bool> startup-visible;
    in-out property <bool> start-with-windows;
    /// The player flipped "Start with Windows"; `wanted` is the new value.
    callback start-with-windows-changed(wanted: bool);
    /// Uninstall section in Settings (installed builds) and its confirmation dialog.
    in property <bool> uninstall-visible;
    in-out property <bool> uninstall-dialog-open;
    in-out property <bool> uninstall-delete-data;
    /// Rust sets it when the uninstaller could not start.
    in-out property <bool> uninstall-failed;
    /// The player confirmed; `delete-data` is "Also delete my settings".
    callback uninstall(delete-data: bool);
    /// A button of the throwaway debug screen was pressed.
    callback debug-event(kind: string);

    if root.screen == Screen.welcome: WelcomeScreen {
        lets-go => {
            root.screen = Screen.history;
            root.welcome-done();
        }
    }

    if root.screen != Screen.welcome: AppShell {
        connected: root.connected;
        status-label: root.status-label;
        settings-active: root.screen == Screen.settings;
        about-active: root.screen == Screen.about;
        settings-clicked => { root.screen = Screen.settings; }
        about-clicked => { root.screen = Screen.about; }

        if root.screen == Screen.history && root.sessions.length == 0: HistoryEmpty {
            vertical-stretch: 1;
        }

        if root.screen == Screen.history && root.sessions.length > 0: HistorySessions {
            vertical-stretch: 1;
            sessions: root.sessions;
            workouts <=> root.history-workouts;
        }

        if root.screen == Screen.about: AboutScreen {
            vertical-stretch: 1;
            version: root.version;
            back => { root.screen = Screen.history; }
        }

        if root.screen == Screen.settings: SettingsScreen {
            vertical-stretch: 1;
            crash-reports: root.crash-reports;
            all-logs: root.all-logs;
            update-visible: root.update-visible;
            update-status: root.update-status;
            update-busy: root.update-busy;
            check-updates => { root.check-updates(); }
            shortcuts-visible: root.shortcuts-visible;
            shortcut-start-menu: root.shortcut-start-menu;
            shortcut-desktop: root.shortcut-desktop;
            shortcut-start-menu-toggled => {
                root.shortcut-start-menu = !root.shortcut-start-menu;
                root.shortcut-start-menu-changed(root.shortcut-start-menu);
            }
            shortcut-desktop-toggled => {
                root.shortcut-desktop = !root.shortcut-desktop;
                root.shortcut-desktop-changed(root.shortcut-desktop);
            }
            startup-visible: root.startup-visible;
            start-with-windows: root.start-with-windows;
            start-with-windows-toggled => {
                root.start-with-windows = !root.start-with-windows;
                root.start-with-windows-changed(root.start-with-windows);
            }
            uninstall-visible: root.uninstall-visible;
            uninstall-clicked => {
                root.uninstall-delete-data = false;
                root.uninstall-failed = false;
                root.uninstall-dialog-open = true;
            }
            debug-tools: root.debug-tools;
            open-debug => { root.screen = Screen.debug; }
            back => { root.screen = Screen.history; }
            crash-reports-toggled => {
                root.crash-reports = !root.crash-reports;
                root.crash-reports-changed(root.crash-reports);
            }
            all-logs-toggled => {
                root.all-logs = !root.all-logs;
                root.all-logs-changed(root.all-logs);
            }
        }

        if root.screen == Screen.debug: DebugScreen {
            vertical-stretch: 1;
            fire(kind) => { root.debug-event(kind); }
            back => { root.screen = Screen.settings; }
        }
    }

    // Over the whole window, top bar included.
    if root.uninstall-dialog-open && root.screen == Screen.settings: SettingsUninstallDialog {
        width: root.width;
        height: root.height;
        delete-data: root.uninstall-delete-data;
        failed: root.uninstall-failed;
        delete-data-toggled => { root.uninstall-delete-data = !root.uninstall-delete-data; }
        cancel => { root.uninstall-dialog-open = false; }
        confirm => { root.uninstall(root.uninstall-delete-data); }
    }
}
